<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_player"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:subtitleTextColor="@color/text_secondary"
        app:titleTextColor="@color/text_primary" />

    <!-- LYRICS SA GITNA -->
    <com.songhub.offline.ui.LyricsView
        android:id="@+id/lyrics"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />

    <!-- CONTROLS SA BABA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_controls"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <!-- Seek bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/timeCurrent"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:progressBackgroundTint="@color/divider"
                android:progressTint="@color/accent"
                android:thumbTint="@color/accent" />

            <TextView
                android:id="@+id/timeTotal"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0:00"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- KEY at TEMPO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/keyDown"
                    style="@style/Songhub.ControlButton"
                    android:layout_width="44dp"
                    android:contentDescription="Key down"
                    android:src="@drawable/ic_remove" />

                <TextView
                    android:id="@+id/keyLabel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="KEY 0"
                    android:textColor="@color/accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/keyUp"
                    style="@style/Songhub.ControlButton"
                    android:layout_width="44dp"
                    android:contentDescription="Key up"
                    android:src="@drawable/ic_add" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/tempoDown"
                    style="@style/Songhub.ControlButton"
                    android:layout_width="44dp"
                    android:contentDescription="Tempo down"
                    android:src="@drawable/ic_remove" />

                <TextView
                    android:id="@+id/tempoLabel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="TEMPO 100%"
                    android:textColor="@color/accent2"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/tempoUp"
                    style="@style/Songhub.ControlButton"
                    android:layout_width="44dp"
                    android:contentDescription="Tempo up"
                    android:src="@drawable/ic_add" />
            </LinearLayout>
        </LinearLayout>

        <!-- VOLUME -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Volume"
                android:src="@drawable/ic_volume_up"
                app:tint="@color/text_secondary" />

            <SeekBar
                android:id="@+id/volume"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progressBackgroundTint="@color/divider"
                android:progressTint="@color/text_primary"
                android:thumbTint="@color/text_primary" />
        </LinearLayout>

        <!-- PLAY / PAUSE / NEXT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnFav"
                style="@style/Songhub.ControlButton"
                android:contentDescription="@string/add_favorite"
                android:src="@drawable/ic_star_border" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnPrev"
                style="@style/Songhub.ControlButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="Previous"
                android:src="@drawable/ic_skip_previous" />

            <ImageButton
                android:id="@+id/btnPlay"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_play_button"
                android:contentDescription="Play / Pause"
                android:scaleType="centerInside"
                android:src="@drawable/ic_play"
                app:tint="@color/on_accent" />

            <ImageButton
                android:id="@+id/btnNext"
                style="@style/Songhub.ControlButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="Next"
                android:src="@drawable/ic_skip_next" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnRestart"
                style="@style/Songhub.ControlButton"
                android:contentDescription="Restart"
                android:src="@drawable/ic_replay" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
