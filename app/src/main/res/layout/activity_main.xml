    <Button android:backgroundTint="#BB86FC" android:id="@+id/btnSelectFolder" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Pumili ng Folder sa SD Card (MIDI)" android:textColor="#000000"/>

